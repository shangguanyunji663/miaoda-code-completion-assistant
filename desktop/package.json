{
  "name": "miaoda-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "妙答桌面版：Electron 壳 + 首次配置向导 + 托盘常驻。agent 逻辑零改动，经 ELECTRON_RUN_AS_NODE 复用其 web-server 与 my-edge。",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.miaoda.desktop",
    "productName": "Miaoda",
    "directories": {
      "output": "dist"
    },
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      {
        "from": "../agent",
        "to": "agent",
        "filter": [
          "src/**",
          "scripts/**",
          "public/**",
          "docs/**",
          "node_modules/**",
          "package.json",
          ".env.example",
          "*.bat",
          "eslint.config.js"
        ]
      },
      { "from": "../shared", "to": "shared" }
    ],
    "asar": true,
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Miaoda-portable-${version}.exe"
    }
  }
}
