# 复制本文件为 .env.local 后填入真实值；.env.local 已被 git 忽略，切勿提交。

# ===== AI 通道（OpenAI 兼容）=====
# 端点、密钥、模型均为个人配置，统一在 .env.local 填写，源码与模板中不落真实值
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=8192
# 推理分级：low / medium / high（medium 实测思考有界且多步命令完整；off 会漏多步要求）
AI_REASONING_EFFORT=medium
# 1 = 开启思考走分级；0 = 思考全关（极简任务）
AI_ENABLE_THINKING=1
# 思考硬闸：流式响应"仍在思考、正文 0 字"持续超过该时长即断流并重试关思考；0 = 不设限。
# 默认 120000（2026-09-15 时间优先：high 档正常思考 60~120s，放行真思考、拦马拉松）
AI_THINKING_CAP_MS=120000
# 思考停滞检测（毫秒）：正文 0 字且思考连续这么久无增长 → 视为空转/卡死提前断流重试；0 = 禁用
AI_THINKING_STALL_MS=45000
# 思考字数配额（字）：正文 0 字且思考累计达到该字数 → 强制断流重试（防弱推理模型无限思考烧光预算）；0 = 禁用
AI_THINKING_MAX_CHARS=24000
# 首轮（首次生成）是否开思考：1 = 开；0 = 关（默认关，时间优先——只有反思轮动用 high 思考档）
AI_FIRST_PASS_THINKING=0
# 单次 AI 请求超时：端点挂起按失败重试，避免 loop 永久停摆
AI_TIMEOUT_MS=300000

# ===== 浏览器 =====
# 需以 --remote-debugging-port 启动；npm run browser 已自动处理
# 注意：默认不用 9222 —— 部分机器 Windows 会把 9137-9236 列为保留端口，
# 导致 bind() 失败（0x271D）。启动脚本会自动检测并顺延。
CDP_ENDPOINT=http://127.0.0.1:9333
DEBUG_PORT=9333
# 题目页 URL 特征片段（挑页第一优先）。显式指定后探测/解题/once/run 都先按它挑页；
# 命中多个标签页会报错列出，避免解错页。留空则自动按 TASK_URL_PATTERN 识别题目页。
# 平台题目页 URL 不是 /tasks/ 形状的（如 /exam/...），在此改成对应特征片段即可。
TARGET_URL_HINT=
# 题目页 URL 形状正则：自动挑页 + watch/lite 识别共用此旋钮。
# 默认匹配 /tasks/<courseId>/<数字>/<串>（eduCoder 官网与校内部署同构）
TASK_URL_PATTERN=/tasks/[^/]+/\d+/[A-Za-z0-9]+

# ===== 循环策略 =====
MAX_RETRY=10
# 多候选择优（1.6.3）：首轮并行生成 K 份候选，用四道本地闸门（py2 语法 / 空 Begin-End /
# 题面对齐 / 多余 print）打分择优再提交。1 = 关闭（默认，行为与旧版一致）；2~5 生效。
# token 成本≈×K，墙钟≈单次（请求并发 + 首轮默认关思考）。K 份全都带同一硬缺陷时日志
# 会记 systemic——多采样救不了，该转终端实测/人工判定
CANDIDATES=1
# 等待评测结果的最长时间（毫秒）。1.5.0 起这是**下限**：结果面板自报「本关最大执行
# 时间 N 秒」更长时，预算自动抬到 N + EVAL_GRACE_MS（实测 Redis 阻塞类题 120 秒）
EVAL_TIMEOUT_MS=25000
# 平台自报执行时间之外的收尾余量（评测跑完还要渲染面板、稳定采样）
EVAL_GRACE_MS=15000
# 评测等待预算上限（面板自报离谱数值时兜住）
EVAL_BUDGET_CAP_MS=300000
# 重交同一份代码时，"面板与点击前一致"要等多久才允许采信（同错复现捷径）。
# 旧版硬编码 3s：实测平台 4 秒时评测根本没跑完 → 把上一轮遗留面板当本轮结果
EVAL_UNCHANGED_MIN_MS=10000
# 评测按钮存在但点不动时的重扫窗口：多半是上一轮评测仍在进行（平台会禁用/遮挡按钮）。
# 窗口到点才放弃，且如实记为 eval-button-busy（不再与"页面没有按钮"混为一谈）
EVAL_CLICK_WAIT_MS=150000
EVAL_CLICK_STEP_MS=3000
COOLDOWN_MS=1500
MAX_TASKS=0
# 1 = 干跑：只感知与生成，不写入编辑器、不点击任何按钮
DRY_RUN=0
